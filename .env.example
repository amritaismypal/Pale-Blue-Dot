NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Server-only read token used only to fetch drafts in authenticated preview mode.
SANITY_API_READ_TOKEN=
# Set this to the hosted preview deployment URL for the Studio Presentation tool.
SANITY_STUDIO_PREVIEW_URL=
# Server-only token with write access for moderated blog comments. Never prefix this with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
